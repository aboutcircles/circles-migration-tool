{
  "name": "circles-migration-tool",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22 <25",
    "pnpm": "10.x"
  },
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc && tsc -p tsconfig.server.json && vite build",
    "preview": "vite preview",
    "start": "node dist-server/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@circles-sdk/adapter": "0.29.1",
    "@circles-sdk/adapter-ethers": "^0.29.1",
    "@circles-sdk/adapter-safe": "^0.29.1",
    "@circles-sdk/data": "^0.29.1",
    "@circles-sdk/profiles": "^0.29.1",
    "@circles-sdk/sdk": "^0.29.1",
    "@circles-sdk/utils": "^0.29.1",
    "@safe-global/protocol-kit": "6.1.2",
    "@tailwindcss/vite": "^4.1.12",
    "@tanstack/react-query": "5.45.1",
    "bip39": "^3.1.0",
    "dotenv": "^17.4.2",
    "ethers": "^6.15.0",
    "express": "^5.2.1",
    "lucide-react": "^0.542.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.0",
    "tailwindcss": "^4.1.12",
    "viem": "latest",
    "vite-plugin-node-polyfills": "^0.24.0",
    "wagmi": "latest"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.39",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@wagmi/cli": "latest",
    "buffer": "^6.0.3",
    "concurrently": "^9.2.1",
    "daisyui": "^5.0.54",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "vite": "^5.2.11",
    "vitest": "^2.1.9"
  }
}
